# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
#
#   copy .env.example .env.local
#
# .env.local 은 .gitignore 대상이다. 절대 커밋하지 않는다.

# Gemini API 키 — 인쇄물 판독에 쓴다.
# aistudio.google.com 에서 개인 구글 계정으로 발급한다. 카드 등록 없이 된다.
#
# 무료 티어는 보낸 내용이 학습에 쓰일 수 있다.
# 개발 중에는 시료명을 가린 스캔본만 넣을 것.
GEMINI_API_KEY=

# 비우면 gemini-2.5-flash 를 쓴다.
# 정확도를 비교할 때만 gemini-2.5-pro 로 바꾼다 (무료 한도가 하루 25회로 적다)
GEMINI_MODEL=
