{
  "name": "lab-sheet-reader",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "read": "tsx scripts/read.ts",
    "dev": "tsx scripts/web.ts",
    "pages:dev": "wrangler pages dev web --env-file=.env.local --show-interactive-dev-session=false",
    "pages:deploy": "wrangler pages deploy web --project-name lab-sheet-reader",
